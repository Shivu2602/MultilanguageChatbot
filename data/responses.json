# --------------------------------------------------
# QUESTION NORMALIZATION
# --------------------------------------------------

def normalize_question(message):
    """
    Removes unnecessary conversational words so that
    natural questions are easier to recognize.
    """

    message = message.lower().strip()

    # Remove punctuation
    message = re.sub(r"[?!.,;:]+", " ", message)

    # Common unnecessary phrases
    filler_phrases = [
        r"\bcan you please\b",
        r"\bcould you please\b",
        r"\bcan you\b",
        r"\bcould you\b",
        r"\bwould you\b",
        r"\bplease\b",
        r"\btell me\b",
        r"\bgive me\b",
        r"\bi want to know\b",
        r"\bi would like to know\b",
        r"\bi need to know\b",
        r"\bdo you know\b",
        r"\bwhat is\b",
        r"\bwhat are\b",
        r"\bwhat about\b",
        r"\bi want information about\b",
        r"\bi need information about\b"
    ]

    for phrase in filler_phrases:
        message = re.sub(phrase, " ", message)

    # Remove extra spaces
    message = re.sub(r"\s+", " ", message).strip()

    return message


# --------------------------------------------------
# LANGUAGE DETECTION
# --------------------------------------------------

def is_kannada(message):
    return bool(re.search(r"[\u0C80-\u0CFF]", message))


# --------------------------------------------------
# KANNADA INTENT RECOGNITION
# --------------------------------------------------

def recognize_kannada_intent(message):

    message = message.lower().strip()

    for intent, phrases in kannada_patterns.items():

        for phrase in phrases:

            if phrase.lower() in message:
                return intent

    return "default"


# --------------------------------------------------
# ENGLISH EXACT PATTERN RECOGNITION
# --------------------------------------------------

def recognize_intent(message):

    message = normalize_question(message)

    for intent, intent_patterns in patterns.items():

        for pattern in intent_patterns:

            if re.search(pattern, message, re.IGNORECASE):
                return intent

    return "default"


# --------------------------------------------------
# ENGLISH KEYWORD SCORING
# --------------------------------------------------

def recognize_intent_by_keywords(message):

    message = normalize_question(message)

    scores = {}

    for intent, keywords in english_keywords.items():

        score = 0

        for keyword in keywords:

            if " " in keyword:

                if keyword in message:
                    score += 3

            else:

                if re.search(
                    rf"\b{re.escape(keyword)}\b",
                    message
                ):
                    score += 1

        scores[intent] = score

    best_intent = max(scores, key=scores.get)

    if scores[best_intent] > 0:
        return best_intent

    return "default"


# --------------------------------------------------
# TYPO / FUZZY MATCHING
# --------------------------------------------------

def similarity(word1, word2):

    return SequenceMatcher(
        None,
        word1.lower(),
        word2.lower()
    ).ratio()


def recognize_typo_intent(message):

    message = normalize_question(message)

    words = re.findall(r"[a-zA-Z]+", message)

    best_intent = "default"
    best_score = 0

    for word in words:

        for intent, keywords in fuzzy_keywords.items():

            for keyword in keywords:

                score = similarity(word, keyword)

                if score > best_score:

                    best_score = score
                    best_intent = intent

    if best_score >= 0.72:
        return best_intent

    return "default"


# --------------------------------------------------
# SMART ENGLISH INTENT
# --------------------------------------------------

def smart_english_intent(message):

    normalized = normalize_question(message)

    # 1. Exact pattern matching
    intent = recognize_intent(normalized)

    if intent != "default":
        return intent

    # 2. Keyword matching
    intent = recognize_intent_by_keywords(normalized)

    if intent != "default":
        return intent

    # 3. Typo / fuzzy matching
    intent = recognize_typo_intent(normalized)

    return intent


# --------------------------------------------------
# TRANSLATE TO ENGLISH
# --------------------------------------------------

def translate_to_english(message):

    try:

        translated = GoogleTranslator(
            source="auto",
            target="en"
        ).translate(message)

        return translated

    except Exception:

        return message


# --------------------------------------------------
# GENERATE RESPONSE
# --------------------------------------------------

def generate_response(language, intent):

    if language not in responses:
        language = "en"

    if intent not in responses[language]:
        intent = "default"

    response_list = responses[language][intent]

    previous_response = session.get(
        "previous_response"
    )

    available_responses = [
        response
        for response in response_list
        if response != previous_response
    ]

    if not available_responses:
        available_responses = response_list

    selected_response = random.choice(
        available_responses
    )

    session["previous_response"] = selected_response

    return selected_response


