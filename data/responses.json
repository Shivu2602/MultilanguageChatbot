# --------------------------------------------------
# CHAT ROUTE
# --------------------------------------------------

@app.route("/chat", methods=["POST"])
def chat():

    data = request.get_json()

    message = data.get("message", "").strip()

    if not message:

        return jsonify({
            "response": "Please enter a message.",
            "intent": "default",
            "language": "en"
        })


    # ----------------------------------------------
    # DETECT LANGUAGE
    # ----------------------------------------------

    language = "kn" if is_kannada(message) else "en"


    # ----------------------------------------------
    # FOLLOW-UP CHECK
    # ----------------------------------------------

    normalized_message = message.lower().strip()

    is_followup = (
        normalized_message in english_followups
        or message.strip() in kannada_followups
    )


    # ----------------------------------------------
    # INTENT RECOGNITION
    # ----------------------------------------------

    if is_followup:

        intent = session.get(
            "previous_intent",
            "default"
        )

    elif language == "kn":

        intent = recognize_kannada_intent(message)

        # If Kannada pattern is not found,
        # translate and use English intelligence.
        if intent == "default":

            translated_message = translate_to_english(
                message
            )

            intent = smart_english_intent(
                translated_message
            )

    else:

        intent = smart_english_intent(message)


    # ----------------------------------------------
    # SAVE CONTEXT
    # ----------------------------------------------

    if intent != "default":

        session["previous_intent"] = intent


    # ----------------------------------------------
    # GENERATE RESPONSE
    # ----------------------------------------------

    response = generate_response(
        language,
        intent
    )


    return jsonify({
        "response": response,
        "intent": intent,
        "language": language
    })


